---
interface Props {
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 768 32" fill="currentColor" aria-hidden="true">
  <defs>
    <pattern id={id} width="64" height="32" patternUnits="userSpaceOnUse">
      <path d="M14 1h4v8h4V5h4v4h-4v4h8v4h-8v4h4v4h-4v-4h-4v8h-4v-8h-4v4H6v-4h4v-4H2v-4h8V9H6V5h4v4h4V1Z" />
      <path d="M46 9h4v6h6v4h-6v6h-4v-6h-6v-4h6V9Z" opacity=".75" />
    </pattern>
  </defs>
  <rect width="768" height="32" fill={`url(#${id})`} />
</svg>
