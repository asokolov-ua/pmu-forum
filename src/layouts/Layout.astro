---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { forum } from '../data/forum';
interface Props {
  title?: string;
  description?: string;
  form?: boolean;
  noindex?: boolean;
}
const {
  title = forum.name,
  description = forum.description,
  form = false,
  noindex = false,
} = Astro.props;
const publicSite = import.meta.env.SITE_URL || Astro.site?.toString();
const canonical =
  publicSite && !publicSite.includes('localhost')
    ? new URL(Astro.url.pathname, publicSite)
    : undefined;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#244644" />
    <title>{title} · ПМУ</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/FixelDisplay-Regular.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/e-UkraineHead-Bold.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={`${title} · ПМУ`} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <meta property="og:image" content={new URL('/og-fni-2026.jpg', publicSite).href} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Форум національної ідентичності. 27–28 листопада 2026, Київ. Патріотична молодь України." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · ПМУ`} />
    <meta name="twitter:description" content={description} />
    {canonical && <meta name="twitter:image" content={new URL('/og-fni-2026.jpg', publicSite).href} />}
    <meta name="twitter:image:alt" content="Форум національної ідентичності. 27–28 листопада 2026, Київ." />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Перейти до змісту
    </a>
    <Header form={form} />
    <slot />
    <Footer />
  </body>
</html>
