# Public URL of the deployed forum. Update when connecting the subdomain.
SITE_URL=http://localhost:4322
# Keep false until the privacy notice, database and Telegram setup are verified.
REGISTRATION_OPEN=false
SUPABASE_URL=
# Server-only Supabase secret key (or legacy service_role key). Never use PUBLIC_.
SUPABASE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated numerical Telegram user IDs of trusted organizers.
TELEGRAM_ADMIN_IDS=
# Random letters/digits/underscores, used for Telegram webhook verification.
TELEGRAM_WEBHOOK_SECRET=
# Independent random secrets (at least 32 characters each).
RATE_LIMIT_SECRET=
CRON_SECRET=
